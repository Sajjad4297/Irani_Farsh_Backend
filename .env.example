# Application Port & Environment (Host loopback port per server guide)
PORT=4011
NODE_ENV=production
TRUST_PROXY=true

# Database Configuration (Connects to shared Postgres container `db` on network `backend`)
DB_HOST=db
DB_PORT=5432
DB_USER=iranifarsh
DB_PASSWORD=your_secure_db_password
DB_NAME=iranifarsh_db

# Security & Authentication (MANDATORY - No fallback)
# Generate using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret

# Admin Accounts (JSON array of admin objects with bcrypt hashed passwords)
# Generate bcrypt hash: node -e "console.log(require('bcrypt').hashSync('YourPassword', 12))"
ADMIN_USERS='[{"name":"Sajjad","username":"sajy","passwordHash":"$2b$12$..."}]'

# EmailJS Configuration (https://www.emailjs.com) - used to send the signup/login OTP email.
# Create a service + template in the EmailJS dashboard; the template must use the
# variables {{to_email}}, {{to_name}} and {{otp_code}}, and "API requests" must be
# enabled for non-browser apps under Account > Security.
EMAILJS_SERVICE_ID=service_i3d0spp
EMAILJS_TEMPLATE_ID=template_iczarak
EMAILJS_PUBLIC_KEY=8rMsEwt4-6Xvr90r4
EMAILJS_PRIVATE_KEY=kxCOHBKDmOgZjlAmyXCcV
# Set to "true" to log the OTP instead of actually sending an email (local/dev use)
EMAIL_MOCK=false

# FarazSMS Configuration (IranPayamak API) - legacy/optional, kept for future SMS features.
# Mobile number is now optional at signup and is no longer used for OTP delivery.
FARAZSMS_API_KEY=your_farazsms_api_key
FARAZSMS_LINE_NUMBER=2191307530
FARAZSMS_BASE_URL=https://api.iranpayamak.com

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://iranifarsh.neofy.ir,https://admin.iranifarsh.neofy.ir
